# Keep these secrets on the backend only. Never put them in the APK.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Base URL of the ACE-Step REST API server (normally port 8001), not the Gradio UI.
ACESTEP_WORKER_URL=
# Must match ACESTEP_API_KEY configured on the GPU worker.
ACESTEP_API_KEY=

# Optional ComfyUI server URL for the future image workflow.
COMFYUI_BASE_URL=

# YouTube OAuth credentials belong in a secure backend secret store.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# Use a mounted persistent disk in production.
SURAJSONG_DB_PATH=/var/data/surajsong.db
